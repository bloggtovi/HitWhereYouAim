{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-vcpkg",
      "displayName": "Windows x64 with vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
	{
		"inherits": ["windows-vcpkg"],
		"name": "vs2022-all",
		"cacheVariables" : { 
			"ENABLE_SKYRIM_SE": "ON",
			"ENABLE_SKYRIM_AE": "ON",
			"ENABLE_SKYRIM_VR": "ON"
		}
	},
	{
		"inherits": ["windows-vcpkg"],
		"name": "vs2022-se-ae",
		"cacheVariables" : {
			"ENABLE_SKYRIM_SE": "ON",
			"ENABLE_SKYRIM_AE": "ON",
			"ENABLE_SKYRIM_VR": "OFF"
		}
	}
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "windows-vcpkg", "configuration": "Debug" },
    { "name": "release", "configurePreset": "windows-vcpkg", "configuration": "Release" }
  ]
}
